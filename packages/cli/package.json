{
  "name": "solution-explorer",
  "version": "1.2.0",
  "description": "Generate interactive architecture diagrams from any codebase",
  "type": "module",
  "bin": {
    "solution-explorer": "dist/index.js"
  },
  "files": [
    "dist",
    "viewer-dist",
    "analyzer",
    "analyze.py",
    "scripts-bundle"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bash scripts/prepare-bundle.sh && npm run build",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "keywords": [
    "architecture",
    "visualization",
    "codebase",
    "diagram",
    "static-analysis"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "sirfifer",
  "repository": {
    "type": "git",
    "url": "https://github.com/sirfifer/solution-explorer.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "prompts": "^2.4.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
