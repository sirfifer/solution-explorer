{
  "name": "arch-visualizer",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "description": "Interactive architecture viewer for solution-explorer",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "sirfifer",
  "repository": {
    "type": "git",
    "url": "https://github.com/sirfifer/solution-explorer.git",
    "directory": "viewer"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:crawl": "playwright test -c tests/crawl/playwright.config.ts",
    "lint": "eslint src/",
    "analyze": "python3 ../analyze.py ../.. -o public/architecture.json && npm run dev"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "elkjs": "^0.12.0",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
  }
}
