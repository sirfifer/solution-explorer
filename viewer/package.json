{
  "name": "arch-visualizer",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "description": "Interactive architecture viewer for solution-explorer",
  "license": "FSL-1.1-Apache-2.0",
  "author": "sirfifer",
  "repository": {
    "type": "git",
    "url": "https://github.com/sirfifer/solution-explorer.git",
    "directory": "viewer"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "analyze": "python3 ../analyze.py ../.. -o public/architecture.json && npm run dev"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "elkjs": "^0.12.0",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.18"
  }
}
