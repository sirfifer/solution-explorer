# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/

# Build artifacts (rebuilt at publish time by release.yml / prepublishOnly)
packages/cli/dist/

# OS junk
.DS_Store

# Generated
# NOTE: the repo-root architecture.json is intentionally tracked. It is the
# committed AI-enhancement baseline that the deploy pipeline merges from, so it
# must not be gitignored. Regenerate it with `python3 analyze.py . -o
# architecture.json` and re-run /ai-assist to restore AI enhancements.
.arch-baseline/

# Blue/green health-check artifact (card G3). Written by scripts/blue-green-diff.py
# on a local dogfood run; uploaded as a CI artifact, never committed.
projection-diff.json

# v2 engine (--engine v2) persistent fact store; the incremental baseline lives
# here by default (<root>/.solution-explorer/index.db). Generated, never tracked.
# The store stays ignored via .solution-explorer/.gitignore (sidecar); the
# learned rules in .solution-explorer/rules/ travel with the repo (P6-12).
.solution-explorer/index.db
.solution-explorer/*.db-wal
.solution-explorer/*.db-shm
# Nested stores too. The three patterns above contain a slash, so git anchors
# them to the repository root, and a store written anywhere else escaped them.
# Running the suite analyzes tests/fixtures/*, which drops a real store beside
# each fixture, and one of those was committed before this rule existed.
**/.solution-explorer/index.db
**/.solution-explorer/*.db-wal
**/.solution-explorer/*.db-shm

# Cloudflare Worker
infrastructure/cloudflare/worker/.wrangler/

# Golden-corpus fetched source (card G2): frozen clones fetched on demand at
# a pinned commit. Never tracked; only tests/golden/<name>/baseline.json is.
.golden-cache/

# Wrangler local cache, written wherever wrangler runs. The demo harness
# (scripts/demo-site.py deploy) runs it from the repo root, so ignore it here
# too, not only under infrastructure/cloudflare/worker/.
.wrangler/

# Testboard run records (scripts/testboard.py). Every harness writes its run
# here as it executes so the dashboard can show it live. Regenerable by
# rerunning the harness, and one record per run adds up, so never tracked.
.testboard/

# Usage calibration (scripts/usage-budget.py). Written from an observation on
# one machine and one subscription, so it is local truth rather than repo truth.
demos/usage-calibration.json

# Enrichment run records (demos/runs/). Committed DELIBERATELY when a run is a
# keeper (git add -f), never swept in by a broad add: two interrupted runs'
# debris, megabytes of ledger and report, reached commits that way on
# 2026-08-25 and had to be rewritten out. The 2026-08-22 dry-run record stays
# tracked; ignoring a path does not untrack it.
demos/runs/
