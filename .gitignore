# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/

# Build artifacts (rebuilt at publish time by release.yml / prepublishOnly)
packages/cli/dist/

# OS junk
.DS_Store

# Generated
# NOTE: the repo-root architecture.json is intentionally tracked. It is the
# committed AI-enhancement baseline that the deploy pipeline merges from, so it
# must not be gitignored. Regenerate it with `python3 analyze.py . -o
# architecture.json` and re-run /ai-assist to restore AI enhancements.
.arch-baseline/

# v2 engine (--engine v2) persistent fact store; the incremental baseline lives
# here by default (<root>/.solution-explorer/index.db). Generated, never tracked.
# The store stays ignored via .solution-explorer/.gitignore (sidecar); the
# learned rules in .solution-explorer/rules/ travel with the repo (P6-12).
.solution-explorer/index.db
.solution-explorer/*.db-wal
.solution-explorer/*.db-shm

# Cloudflare Worker
infrastructure/cloudflare/worker/.wrangler/

# Golden-corpus fetched source (card G2): frozen clones fetched on demand at
# a pinned commit. Never tracked; only tests/golden/<name>/baseline.json is.
.golden-cache/
