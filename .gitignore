.DS_Store

# Generated
# NOTE: the repo-root architecture.json is intentionally tracked. It is the
# committed AI-enhancement baseline that the deploy pipeline merges from, so it
# must not be gitignored. Regenerate it with `python3 analyze.py . -o
# architecture.json` and re-run /ai-assist to restore AI enhancements.
.arch-baseline/

# v2 engine (--engine v2) persistent fact store; the incremental baseline lives
# here by default (<root>/.solution-explorer/index.db). Generated, never tracked.
.solution-explorer/

# Cloudflare Worker
infrastructure/cloudflare/worker/.wrangler/
