{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sirfifer/solution-explorer/docs/publication/publication.schema.json",
  "title": "Publication metadata for a deployed viewer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publication_version",
    "publisher",
    "subject",
    "purpose",
    "update_policy",
    "header",
    "footer",
    "disclaimers",
    "access",
    "generated_by"
  ],
  "properties": {
    "publication_version": { "type": "integer", "const": 1 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contact"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "contact": { "type": "string", "minLength": 1 },
        "url": { "type": "string" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "commit", "snapshot_date", "affiliation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repo_url": { "type": "string" },
        "license": { "type": "string" },
        "commit": { "type": "string", "minLength": 7 },
        "snapshot_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "affiliation": { "enum": ["owner", "maintainer", "contributor", "none"] }
      }
    },
    "purpose": { "enum": ["demo", "documentation", "internal", "evaluation", "other"] },
    "update_policy": { "enum": ["snapshot", "periodic", "continuous"] },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["banner"],
      "properties": {
        "banner": { "type": "string", "minLength": 1 },
        "front_page": { "type": "array", "items": { "type": "string" } }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["always"],
      "properties": {
        "always": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "front_page": { "type": "array", "items": { "type": "string" } }
      }
    },
    "context": { "type": "array", "items": { "type": "string" } },
    "disclaimers": { "type": "array", "items": { "type": "string" } },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility"],
      "properties": {
        "visibility": { "enum": ["public", "private-preview", "internal"] },
        "gate": { "type": ["string", "null"] }
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
